---
import '../styles/global.css'

interface Props {
  title: string
  onClick: string
  buttonLabel: string
}

const { title, onClick, buttonLabel } = Astro.props
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" href="/images/logo.png" />
    <style>
      @keyframes twinkle {
        0%,
        100% {
          opacity: 0.3;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.5);
        }
      }
    </style>
  </head>
  <body
    class="min-h-dvh flex flex-col gap-5 items-center justify-center bg-linear-to-br from-slate-900 via-blue-900 to-black font-sans"
  >
    <div class="fixed inset-0 pointer-events-none">
      {
        Array.from({ length: 50 }).map(() => (
          <div
            class="animate-[2s_ease-in-out_infinite_twinkle] absolute bg-white w-[3px] h-[3px] rounded-full"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
              animationDelay: `${Math.random() * 2}s`,
            }}
          />
        ))
      }
    </div>
    <div class="text-white text-3xl font-bold"><slot /></div>
    <button
      onclick={onClick}
      class="bg-white text-blue-900 py-2 px-6 rounded-full cursor-pointer font-semibold"
    >
      {buttonLabel}
    </button>
  </body>
</html>
